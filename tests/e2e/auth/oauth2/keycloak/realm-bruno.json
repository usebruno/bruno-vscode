{
  "realm": "bruno",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 300,
  "users": [
    {
      "username": "testuser",
      "enabled": true,
      "email": "testuser@example.com",
      "emailVerified": true,
      "firstName": "Test",
      "lastName": "User",
      "credentials": [{ "type": "password", "value": "testpass", "temporary": false }]
    }
  ],
  "clients": [
    {
      "clientId": "bruno-client-credentials",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "bruno-client-credentials-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    },
    {
      "clientId": "bruno-password",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "bruno-password-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true
    },
    {
      "clientId": "bruno-auth-code",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "bruno-auth-code-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["https://oauth.usebruno.com/vscode/callback"]
    },
    {
      "clientId": "bruno-auth-code-pkce",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["https://oauth.usebruno.com/vscode/callback"],
      "attributes": { "pkce.code.challenge.method": "S256" }
    },
    {
      "clientId": "bruno-implicit",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["https://oauth.usebruno.com/vscode/callback"]
    }
  ]
}
