{
  "name": "bruno",
  "displayName": "Bruno",
  "description": "API client for exploring and testing APIs in VS Code",
  "version": "6.0.0",
  "publisher": "bruno-api-client",
  "license": "MIT",
  "icon": "media/bruno-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/usebruno/bruno-vscode"
  },
  "homepage": "https://www.usebruno.com",
  "bugs": {
    "url": "https://github.com/usebruno/bruno-vscode/issues"
  },
  "extensionKind": [
    "workspace"
  ],
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Testing",
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "Bruno",
    "API Client",
    "GraphQL",
    "gRPC",
    "HTTP",
    "REST",
    "Testing",
    "Bruno API",
    "Postman",
    "Thunder Client"
  ],
  "activationEvents": [
    "workspaceContains:**/bruno.json",
    "workspaceContains:**/opencollection.yaml",
    "workspaceContains:**/opencollection.yml"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "bruno",
          "title": "Bruno",
          "icon": "media/logo-sidebar.svg"
        }
      ],
      "panel": [
        {
          "id": "brunoLogsContainer",
          "title": "Bruno Logs",
          "icon": "$(output)"
        }
      ]
    },
    "views": {
      "brunoLogsContainer": [
        {
          "id": "bruno.logsView",
          "name": "Logs",
          "type": "webview",
          "icon": "$(output)"
        }
      ],
      "bruno": [
        {
          "type": "webview",
          "id": "bruno.sidebarView",
          "name": "Collections",
          "contextualTitle": "Bruno Collections",
          "icon": "$(folder-library)",
          "when": "!bruno.nativeComponents"
        },
        {
          "type": "tree",
          "id": "bruno.nativeSidebarView",
          "name": "Collections",
          "contextualTitle": "Bruno Collections",
          "icon": "$(folder-library)",
          "when": "bruno.nativeComponents"
        }
      ],
      "explorer": [
        {
          "id": "bruno.workspaceCollections",
          "name": "Bruno Collections",
          "when": "workbenchState != empty",
          "icon": "media/logo-sidebar.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "bruno.nativeSidebarView",
        "contents": "No Bruno collections were found in the open folders.\n[Create Collection](command:bruno.sidebar.createCollection)\n[Open Collection](command:bruno.sidebar.openCollection)",
        "when": "bruno.nativeComponents && bruno.sidebar.empty"
      }
    ],
    "commands": [
      {
        "command": "bruno.switchFileEditor",
        "title": "Open with Bruno Editor",
        "category": "Bruno",
        "icon": {
          "light": "media/bruno-icon.svg",
          "dark": "media/bruno-icon.svg"
        }
      },
      {
        "command": "bruno.switchToTextEditor",
        "title": "Open with Text Editor",
        "category": "Bruno",
        "icon": "$(go-to-file)"
      },
      {
        "command": "bruno.runCollection",
        "title": "Open in Bruno Runner",
        "category": "Bruno",
        "icon": "$(play)"
      },
      {
        "command": "bruno.openSettings",
        "title": "Open Collection Settings",
        "category": "Bruno",
        "icon": "$(settings-gear)"
      },
      {
        "command": "bruno.createCollection",
        "title": "Create Collection",
        "category": "Bruno",
        "icon": "$(file-directory-create)"
      },
      {
        "command": "bruno.openCollection",
        "title": "Open Collection",
        "category": "Bruno",
        "icon": "$(folder-opened)"
      },
      {
        "command": "bruno.importCollection",
        "title": "Import Collection",
        "category": "Bruno",
        "icon": "$(file-symlink-directory)"
      },
      {
        "command": "bruno.refreshSidebar",
        "title": "Refresh",
        "category": "Bruno",
        "icon": "$(refresh)"
      },
      {
        "command": "bruno.newRequest",
        "title": "New Request",
        "category": "Bruno",
        "icon": "$(add)"
      },
      {
        "command": "bruno.refreshWorkspaceCollections",
        "title": "Refresh",
        "category": "Bruno",
        "icon": "$(refresh)"
      },
      {
        "command": "bruno.openRequestFromTree",
        "title": "Open Request",
        "category": "Bruno"
      },
      {
        "command": "bruno.runCollectionFromTree",
        "title": "Run Collection",
        "category": "Bruno",
        "icon": "$(play)"
      },
      {
        "command": "bruno.runFolderFromTree",
        "title": "Run Folder",
        "category": "Bruno",
        "icon": "$(play)"
      },
      {
        "command": "bruno.openCollectionSettingsFromTree",
        "title": "Collection Settings",
        "category": "Bruno",
        "icon": "$(settings-gear)"
      },
      {
        "command": "bruno.newRequestInCollection",
        "title": "New Request",
        "category": "Bruno",
        "icon": "$(add)"
      },
      {
        "command": "bruno.newFolderInCollection",
        "title": "New Folder",
        "category": "Bruno",
        "icon": "$(new-folder)"
      },
      {
        "command": "bruno.revealInExplorer",
        "title": "Reveal in Explorer",
        "category": "Bruno"
      },
      {
        "command": "bruno.deleteItemFromTree",
        "title": "Delete",
        "category": "Bruno",
        "icon": "$(trash)"
      },
      {
        "command": "bruno.renameItemFromTree",
        "title": "Rename",
        "category": "Bruno"
      },
      {
        "command": "bruno.saveFromEditor",
        "title": "Save Request",
        "category": "Bruno"
      },
      {
        "command": "bruno.clearLogs",
        "title": "Clear Logs",
        "category": "Bruno",
        "icon": "$(clear-all)"
      },
      {
        "command": "bruno.openVariables",
        "title": "Open Variables",
        "category": "Bruno"
      },
      {
        "command": "bruno.openCreateCollection",
        "title": "Create Collection",
        "category": "Bruno"
      },
      {
        "command": "bruno.openGlobalEnvironments",
        "title": "Open Global Environments",
        "category": "Bruno"
      },
      {
        "command": "bruno.openPreferences",
        "title": "Open Preferences",
        "category": "Bruno",
        "icon": "$(settings-gear)"
      },
      {
        "command": "bruno.openEnvironmentSettings",
        "title": "Open Environment Settings",
        "category": "Bruno"
      },
      {
        "command": "bruno.openNewRequest",
        "title": "New Request",
        "category": "Bruno"
      },
      {
        "command": "bruno.openExportCollection",
        "title": "Export Collection",
        "category": "Bruno"
      },
      {
        "command": "bruno.openCloneCollection",
        "title": "Clone Collection",
        "category": "Bruno"
      },
      {
        "command": "bruno.sidebar.createCollection",
        "title": "Create Collection",
        "category": "Bruno",
        "icon": "$(file-directory-create)"
      },
      {
        "command": "bruno.sidebar.search",
        "title": "Search Requests",
        "category": "Bruno",
        "icon": "$(search)"
      },
      {
        "command": "bruno.sidebar.clearSearch",
        "title": "Clear Search",
        "category": "Bruno",
        "icon": "$(clear-all)"
      },
      {
        "command": "bruno.sidebar.refresh",
        "title": "Refresh Collections",
        "category": "Bruno",
        "icon": "$(refresh)"
      },
      {
        "command": "bruno.sidebar.openCollection",
        "title": "Open Collection",
        "category": "Bruno",
        "icon": "$(folder-opened)"
      },
      {
        "command": "bruno.sidebar.closeCollection",
        "title": "Remove",
        "category": "Bruno",
        "icon": "$(close)"
      },
      {
        "command": "bruno.sidebar.newRequest",
        "title": "New Request",
        "category": "Bruno",
        "icon": "$(new-file)"
      },
      {
        "command": "bruno.sidebar.newFolder",
        "title": "New Folder",
        "category": "Bruno",
        "icon": "$(new-folder)"
      },
      {
        "command": "bruno.sidebar.run",
        "title": "Run",
        "category": "Bruno",
        "icon": "$(play)"
      },
      {
        "command": "bruno.sidebar.settings",
        "title": "Settings",
        "category": "Bruno",
        "icon": "$(settings-gear)"
      },
      {
        "command": "bruno.sidebar.clone",
        "title": "Clone",
        "category": "Bruno",
        "icon": "$(files)"
      },
      {
        "command": "bruno.sidebar.export",
        "title": "Export",
        "category": "Bruno",
        "icon": "$(export)"
      },
      {
        "command": "bruno.sidebar.copy",
        "title": "Copy",
        "category": "Bruno",
        "icon": "$(copy)"
      },
      {
        "command": "bruno.sidebar.paste",
        "title": "Paste",
        "category": "Bruno",
        "icon": "$(clippy)"
      },
      {
        "command": "bruno.sidebar.rename",
        "title": "Rename",
        "category": "Bruno",
        "icon": "$(edit)"
      },
      {
        "command": "bruno.sidebar.revealInFinder",
        "title": "Reveal in Finder",
        "category": "Bruno",
        "icon": "$(folder-opened)"
      },
      {
        "command": "bruno.sidebar.revealInFileExplorer",
        "title": "Reveal in File Explorer",
        "category": "Bruno",
        "icon": "$(folder-opened)"
      },
      {
        "command": "bruno.sidebar.revealInFileManager",
        "title": "Reveal in File Manager",
        "category": "Bruno",
        "icon": "$(folder-opened)"
      },
      {
        "command": "bruno.sidebar.delete",
        "title": "Delete",
        "category": "Bruno",
        "icon": "$(trash)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "bruno.switchFileEditor",
          "when": "(resourceExtname == .bru || resourceExtname == .yml) && activeCustomEditorId != bruno.requestEditor",
          "group": "navigation"
        },
        {
          "command": "bruno.switchToTextEditor",
          "when": "(resourceExtname == .bru || resourceExtname == .yml) && activeCustomEditorId == bruno.requestEditor",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "bruno.runCollection",
          "when": "explorerResourceIsFolder",
          "group": "bruno@1"
        },
        {
          "command": "bruno.openSettings",
          "when": "explorerResourceIsFolder",
          "group": "bruno@2"
        }
      ],
      "view/title": [
        {
          "command": "bruno.clearLogs",
          "when": "view == bruno.logsView",
          "group": "navigation"
        },
        {
          "command": "bruno.createCollection",
          "when": "view == bruno.sidebarView",
          "group": "navigation@1"
        },
        {
          "command": "bruno.openCollection",
          "when": "view == bruno.sidebarView",
          "group": "navigation@2"
        },
        {
          "command": "bruno.importCollection",
          "when": "view == bruno.sidebarView",
          "group": "navigation@3"
        },
        {
          "command": "bruno.refreshWorkspaceCollections",
          "when": "view == bruno.workspaceCollections",
          "group": "navigation"
        },
        {
          "command": "bruno.sidebar.search",
          "when": "view == bruno.nativeSidebarView",
          "group": "navigation@1"
        },
        {
          "command": "bruno.sidebar.clearSearch",
          "when": "view == bruno.nativeSidebarView && bruno.sidebar.filtered",
          "group": "navigation@2"
        },
        {
          "command": "bruno.sidebar.createCollection",
          "when": "view == bruno.nativeSidebarView",
          "group": "navigation@3"
        },
        {
          "command": "bruno.sidebar.openCollection",
          "when": "view == bruno.nativeSidebarView",
          "group": "navigation@4"
        },
        {
          "command": "bruno.sidebar.refresh",
          "when": "view == bruno.nativeSidebarView",
          "group": "navigation@5"
        },
        {
          "command": "bruno.openPreferences",
          "when": "view == bruno.nativeSidebarView",
          "group": "navigation@6"
        }
      ],
      "view/item/context": [
        {
          "command": "bruno.runCollectionFromTree",
          "when": "view == bruno.workspaceCollections && viewItem == collection",
          "group": "1_run@1"
        },
        {
          "command": "bruno.runFolderFromTree",
          "when": "view == bruno.workspaceCollections && viewItem == folder",
          "group": "1_run@1"
        },
        {
          "command": "bruno.openCollectionSettingsFromTree",
          "when": "view == bruno.workspaceCollections && viewItem == collection",
          "group": "1_run@2"
        },
        {
          "command": "bruno.newRequestInCollection",
          "when": "view == bruno.workspaceCollections && viewItem =~ /^(collection|folder)$/",
          "group": "2_new@1"
        },
        {
          "command": "bruno.newFolderInCollection",
          "when": "view == bruno.workspaceCollections && viewItem =~ /^(collection|folder)$/",
          "group": "2_new@2"
        },
        {
          "command": "bruno.renameItemFromTree",
          "when": "view == bruno.workspaceCollections && viewItem =~ /^(folder|http-request|graphql-request|grpc-request|ws-request)$/",
          "group": "3_edit@1"
        },
        {
          "command": "bruno.deleteItemFromTree",
          "when": "view == bruno.workspaceCollections && viewItem =~ /^(folder|http-request|graphql-request|grpc-request|ws-request)$/",
          "group": "3_edit@2"
        },
        {
          "command": "bruno.revealInExplorer",
          "when": "view == bruno.workspaceCollections",
          "group": "4_misc@1"
        },
        {
          "command": "bruno.sidebar.newRequest",
          "when": "view == bruno.nativeSidebarView && viewItem =~ /^(collection(:opened)?|folder)$/",
          "group": "inline@1"
        },
        {
          "command": "bruno.sidebar.run",
          "when": "view == bruno.nativeSidebarView && viewItem =~ /^(collection(:opened)?|folder)$/",
          "group": "inline@2"
        },
        {
          "command": "bruno.sidebar.newRequest",
          "when": "view == bruno.nativeSidebarView && viewItem =~ /^(collection(:opened)?|folder)$/",
          "group": "1_new@1"
        },
        {
          "command": "bruno.sidebar.newFolder",
          "when": "view == bruno.nativeSidebarView && viewItem =~ /^(collection(:opened)?|folder)$/",
          "group": "1_new@2"
        },
        {
          "command": "bruno.sidebar.run",
          "when": "view == bruno.nativeSidebarView && viewItem =~ /^(collection(:opened)?|folder)$/",
          "group": "2_run@1"
        },
        {
          "command": "bruno.sidebar.settings",
          "when": "view == bruno.nativeSidebarView && viewItem =~ /^collection(:opened)?$/",
          "group": "2_run@2"
        },
        {
          "command": "bruno.sidebar.clone",
          "when": "view == bruno.nativeSidebarView && viewItem =~ /^(collection(:opened)?$|folder$|request:)/",
          "group": "3_edit@1"
        },
        {
          "command": "bruno.sidebar.export",
          "when": "view == bruno.nativeSidebarView && viewItem =~ /^collection(:opened)?$/",
          "group": "3_edit@2"
        },
        {
          "command": "bruno.sidebar.copy",
          "when": "view == bruno.nativeSidebarView && viewItem =~ /^(folder|request:)/",
          "group": "3_edit@3"
        },
        {
          "command": "bruno.sidebar.paste",
          "when": "view == bruno.nativeSidebarView && viewItem =~ /^(collection(:opened)?|folder)$/ && bruno.sidebar.hasCopiedItem",
          "group": "3_edit@4"
        },
        {
          "command": "bruno.sidebar.rename",
          "when": "view == bruno.nativeSidebarView && viewItem =~ /^(collection(:opened)?$|folder$|request:)/",
          "group": "3_edit@5"
        },
        {
          "command": "bruno.sidebar.revealInFinder",
          "when": "view == bruno.nativeSidebarView && viewItem != collection:unavailable && !isWeb && isMac",
          "group": "4_misc@1"
        },
        {
          "command": "bruno.sidebar.revealInFileExplorer",
          "when": "view == bruno.nativeSidebarView && viewItem != collection:unavailable && !isWeb && isWindows",
          "group": "4_misc@1"
        },
        {
          "command": "bruno.sidebar.revealInFileManager",
          "when": "view == bruno.nativeSidebarView && viewItem != collection:unavailable && !isWeb && isLinux",
          "group": "4_misc@1"
        },
        {
          "command": "bruno.sidebar.delete",
          "when": "view == bruno.nativeSidebarView && viewItem =~ /^(folder|request:)/",
          "group": "9_danger@1"
        },
        {
          "command": "bruno.sidebar.closeCollection",
          "when": "view == bruno.nativeSidebarView && viewItem =~ /^collection:(opened|unavailable)$/",
          "group": "9_danger@1"
        }
      ],
      "commandPalette": [
        {
          "command": "bruno.sidebar.createCollection",
          "when": "bruno.nativeComponents"
        },
        {
          "command": "bruno.sidebar.openCollection",
          "when": "bruno.nativeComponents"
        },
        {
          "command": "bruno.sidebar.search",
          "when": "bruno.nativeComponents"
        },
        {
          "command": "bruno.sidebar.clearSearch",
          "when": "bruno.nativeComponents && bruno.sidebar.filtered"
        },
        {
          "command": "bruno.sidebar.closeCollection",
          "when": "false"
        },
        {
          "command": "bruno.sidebar.newRequest",
          "when": "false"
        },
        {
          "command": "bruno.sidebar.newFolder",
          "when": "false"
        },
        {
          "command": "bruno.sidebar.run",
          "when": "false"
        },
        {
          "command": "bruno.sidebar.settings",
          "when": "false"
        },
        {
          "command": "bruno.sidebar.clone",
          "when": "false"
        },
        {
          "command": "bruno.sidebar.export",
          "when": "false"
        },
        {
          "command": "bruno.sidebar.copy",
          "when": "false"
        },
        {
          "command": "bruno.sidebar.paste",
          "when": "false"
        },
        {
          "command": "bruno.sidebar.rename",
          "when": "false"
        },
        {
          "command": "bruno.sidebar.revealInFinder",
          "when": "false"
        },
        {
          "command": "bruno.sidebar.revealInFileExplorer",
          "when": "false"
        },
        {
          "command": "bruno.sidebar.revealInFileManager",
          "when": "false"
        },
        {
          "command": "bruno.sidebar.delete",
          "when": "false"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "bruno.requestEditor",
        "displayName": "Bruno Request Editor",
        "selector": [
          {
            "filenamePattern": "*.bru"
          },
          {
            "filenamePattern": "*.yml"
          }
        ],
        "priority": "option"
      }
    ],
    "languages": [
      {
        "id": "bru",
        "extensions": [
          ".bru"
        ],
        "aliases": [
          "Bruno Request"
        ],
        "icon": {
          "light": "./media/bruno-icon.png",
          "dark": "./media/bruno-icon.png"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "bru",
        "scopeName": "source.bru",
        "path": "./syntaxes/bruno.tmLanguage.json"
      }
    ],
    "keybindings": [
      {
        "command": "bruno.saveFromEditor",
        "key": "ctrl+s",
        "mac": "cmd+s",
        "when": "activeCustomEditorId == 'bruno.requestEditor'"
      },
      {
        "command": "bruno.saveFromEditor",
        "key": "ctrl+s",
        "mac": "cmd+s",
        "when": "activeWebviewPanelId == 'bruno.transientRequest'"
      },
      {
        "command": "bruno.sidebar.rename",
        "key": "f2",
        "when": "focusedView == bruno.nativeSidebarView"
      },
      {
        "command": "bruno.sidebar.delete",
        "key": "delete",
        "mac": "cmd+backspace",
        "when": "focusedView == bruno.nativeSidebarView"
      },
      {
        "command": "bruno.sidebar.copy",
        "key": "ctrl+c",
        "mac": "cmd+c",
        "when": "focusedView == bruno.nativeSidebarView"
      },
      {
        "command": "bruno.sidebar.paste",
        "key": "ctrl+v",
        "mac": "cmd+v",
        "when": "focusedView == bruno.nativeSidebarView"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "npm run build:extension && npm run build:webview",
    "build:extension": "node esbuild.extension.mjs",
    "build:webview": "rsbuild build -c rsbuild.webview.config.mjs",
    "dev": "npm run dev:extension & npm run dev:webview",
    "dev:extension": "node esbuild.extension.mjs --watch",
    "dev:webview": "rsbuild dev -c rsbuild.webview.config.mjs",
    "copy:ui": "node scripts/copy-ui.js",
    "copy:packages": "node scripts/copy-packages.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "package": "npx @vscode/vsce package --no-dependencies",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:server": "npx tsx tests/e2e/server/index.ts",
    "test:keycloak:up": "docker compose -f tests/e2e/auth/oauth2/keycloak/docker-compose.yml up -d --wait",
    "test:keycloak:down": "docker compose -f tests/e2e/auth/oauth2/keycloak/docker-compose.yml down",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:cursor": "CURSOR_PATH=$(which cursor 2>/dev/null || echo '') playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@rsbuild/core": "^1.1.2",
    "@rsbuild/plugin-babel": "^1.0.3",
    "@rsbuild/plugin-node-polyfill": "^1.2.0",
    "@rsbuild/plugin-react": "^1.0.7",
    "@rsbuild/plugin-sass": "^1.1.0",
    "@rsbuild/plugin-styled-components": "^1.6.0",
    "@types/adm-zip": "^0.5.7",
    "@types/cors": "^2.8.19",
    "@types/decomment": "^0.9.5",
    "@types/express": "^5.0.6",
    "@types/fs-extra": "^11.0.4",
    "@types/lodash": "^4.17.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/styled-components": "^5.1.26",
    "@types/uuid": "^10.0.0",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "@vscode/test-electron": "^3.1.0",
